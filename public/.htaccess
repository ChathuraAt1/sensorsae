# ==============================================================================
# SENSORSAE.NET - Production Apache SPA Configuration
# Routes all virtual paths (e.g. /auth/complete, /dashboard, /checkout) to index.html
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite physical files, directories, or symbolic links
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Route all other routes to index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# ==============================================================================
# Security Options
# ==============================================================================
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Prevent access to hidden files and directories (except .well-known)
<IfModule mod_rewrite.c>
  RewriteCond %{REQUEST_URI} "!/\.well-known/"
  RewriteRule "(^|/)\.(?!htaccess)" - [F]
</IfModule>

# ==============================================================================
# Cache Control
# Ensure index.html is never cached stale while hashed assets are cached
# ==============================================================================
<IfModule mod_headers.c>
  # Never cache index.html so app updates take effect immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache static assets with hash in filename
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ==============================================================================
# MIME Types
# ==============================================================================
<IfModule mod_mime.c>
  AddType application/javascript js mjs
  AddType text/css css
  AddType image/svg+xml svg svgz
  AddType image/webp webp
  AddType font/woff woff
  AddType font/woff2 woff2
</IfModule>
